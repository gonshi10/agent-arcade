# Dependencies (this project ships zero runtime deps, but tooling may add some)
node_modules/

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Backups written by the hooks installer before any settings.json write
*.bak

# Personal, per-user Claude Code settings (the default install scope).
# The shared .claude/settings.json IS tracked — only the local one is ignored.
.claude/settings.local.json

# Editor / OS cruft
.DS_Store
.idea/
.vscode/
*.swp
